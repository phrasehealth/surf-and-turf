# ---- agent ---------------------------------------------------------------
AGENT_MODE=sdk                      # sdk | mock
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
# Bedrock cross-region inference profile ID (or an application inference profile ARN)
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5
AGENT_MAX_TURNS=40
AGENT_MAX_BUDGET_USD=2.00
# Optional: Bedrock API key instead of the IAM credential chain
# AWS_BEARER_TOKEN_BEDROCK=

# ---- snowflake (read-only role!) ----------------------------------------
SNOWFLAKE_MODE=real                 # real | mock
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=REPORT_AGENT
SNOWFLAKE_ROLE=REPORT_READER
SNOWFLAKE_WAREHOUSE=REPORTING_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=CDS
# One of:
SNOWFLAKE_PASSWORD=
# Key-pair auth (preferred). Put the unencrypted PKCS#8 key in secrets/ -- see secrets/README.md.
# Compose overrides this with the in-container mount path.
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_key.p8
SQL_ROW_LIMIT=500
SQL_TIMEOUT_S=120

# ---- reports -------------------------------------------------------------
REPORT_STORAGE=s3                   # s3 | local
REPORT_S3_BUCKET=phrase-report-agent-output
REPORT_S3_PREFIX=reports/
REPORT_URL_TTL_S=86400
PUBLIC_BASE_URL=                    # only needed for REPORT_STORAGE=local behind a proxy

# ---- server --------------------------------------------------------------
SESSION_IDLE_TTL_S=3600
CORS_ORIGINS=
