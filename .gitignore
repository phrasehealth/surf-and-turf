.env
data/
# Generated Query Context Pack (build it: scripts/query_context_pack_extractors/)
workspace/*/qcp/
# except the mock fixture, which the offline path needs
!workspace/mock_db_fixture/qcp/
__pycache__/
*.pyc
.pytest_cache/
.venv/
run/
# Credential material: the secrets/ dir has its own .gitignore too.
secrets/*
!secrets/.gitignore
!secrets/README.md
*.p8
*.pem
*.key
